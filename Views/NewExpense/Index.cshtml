@model ExpenseTracker.Models.ExpenseViewModel
@{
    ViewData["Title"] = "Add a New Expense";
}

<div class="text-center">
    <form asp-action="CreateExpense" method="post">
        <label asp-for="ExpenseDate" />
        <input asp-for="ExpenseDate" />
        <span asp-validation-for="ExpenseDate" class="text-danger"></span>
        <label asp-for="CategoryId" />
        <select asp-for="CategoryId" asp-items="@(new SelectList(@ViewBag.categories, "CategoryID", "CategoryName"))">
            <option value="">Select Category</option>
        </select>
        <label asp-for="Amount" />
        <input asp-for="Amount" />
        <span asp-validation-for="Amount" class="text-danger"></span>
        <label asp-for="Description" />
        <textarea asp-for="Description" />
        <span asp-validation-for="Description" class="text-danger"></span>
        <input type="submit" value="Save" class="btn btn-primary" />
    </form>
</div>