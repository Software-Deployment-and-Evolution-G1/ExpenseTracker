@model ExpenseTracker.Models.ExpenseViewModel

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <h1 class="h2">Edit Expense</h1>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-controller="Expense" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div class="my-3 flex flex-column">
                        <input type="hidden" asp-for="Id" />
                        <label asp-for="ExpenseDate" class="form-label"></label>
                        <input asp-for="ExpenseDate" class="form-control" />
                        <span asp-validation-for="ExpenseDate" class="text-danger"></span>
                    </div>
                    <div class="my-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select"
                                asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="my-3 justify-content-center items-center">
                        <label asp-for="Amount" class="form-label"></label>
                        <input asp-for="Amount" class="form-control" />
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    <div class="my-3 justify-content-center items-center">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <input type="submit" value="Update" class="btn btn-primary w-100" />
                    <a asp-controller="Home" asp-action="Index" class="btn btn-link w-100 mt-2">Back to expenses</a>
                </form>
            </div>
        </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
