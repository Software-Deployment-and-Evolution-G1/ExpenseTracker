@model ExpenseTracker.Models.ExpenseViewModel

<div>
    <form asp-action="UpdateExpense">
        <input type="hidden" asp-for="Id" />
        <label asp-for="ExpenseDate"></label>
        <input asp-for="ExpenseDate" />
        <span asp-validation-for="ExpenseDate" class="text-danger"></span>
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId"
                asp-items="@(new SelectList(@ViewBag.categories, "CategoryID", "CategoryName"))">
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
        <label asp-for="Amount"></label>
        <input asp-for="Amount" />
        <span asp-validation-for="Amount" class="text-danger"></span>
        <label asp-for="Description"> </label>
        <textarea asp-for="Description"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
        <input type="submit" value="Update" class="btn btn-primary" />
    </form>
    <p><a asp-action="Index">Back to expenses.</a></p>
</div>